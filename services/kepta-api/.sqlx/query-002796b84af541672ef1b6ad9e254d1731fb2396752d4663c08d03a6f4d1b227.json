  "query": "\n        SELECT id, household_id, room_id, category, name, brand, model_number,\n               serial_number, purchase_date, install_date, warranty_expiry, notes,\n               created_at, updated_at\n        FROM items\n        WHERE household_id = $1 AND deleted_at IS NULL\n        ORDER BY name ASC\n        ",
