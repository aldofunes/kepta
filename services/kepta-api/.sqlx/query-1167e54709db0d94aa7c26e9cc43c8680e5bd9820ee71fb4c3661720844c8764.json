{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT h.id, h.name, h.address, h.year_built, h.sqft, h.created_at, h.updated_at\n        FROM households h\n        JOIN household_members hm ON hm.household_id = h.id\n        WHERE hm.user_id = $1 AND hm.joined_at IS NOT NULL\n        ORDER BY h.created_at DESC\n        ",
