  "query": "\n        SELECT id, household_id, item_id, type AS doc_type, title, file_key,\n               file_size_bytes, mime_type, ocr_status, uploaded_by, created_at, updated_at\n        FROM documents\n        WHERE household_id = $1 AND deleted_at IS NULL\n        ORDER BY created_at DESC\n        ",
