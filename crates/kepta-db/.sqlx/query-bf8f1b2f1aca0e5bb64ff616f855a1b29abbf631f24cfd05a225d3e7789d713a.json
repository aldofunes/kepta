  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.email, u.display_name, u.password_hash, u.avatar_url, u.created_at, u.updated_at\n        FROM users u\n        JOIN oauth_accounts oa ON oa.user_id = u.id\n        WHERE oa.provider = $1 AND oa.provider_sub = $2\n        ",
